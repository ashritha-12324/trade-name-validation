# ─── LLM Provider ────────────────────────────────────────────────────────────
# Choose one: ollama | groq | gemini | openai | openai_compatible
LLM_PROVIDER=ollama

# ─── Ollama (local) ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# ─── Groq ────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
